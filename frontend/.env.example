# Copy to .env.local before running the frontend:
#   cp .env.example .env.local
#
# Base URL of the Flow API. Must match the backend's PORT (default 3000) and
# must be present in the backend's CORS_ORIGINS allow-list.
#
# NEXT_PUBLIC_ prefix is required — without it Next.js will not expose the
# value to browser code, and every API call silently falls back to the
# hardcoded default in src/services/api.ts.
NEXT_PUBLIC_API_URL=http://localhost:3000

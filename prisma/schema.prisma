// ============================================================
// TAGS & CUSTOM FIELDS
// ============================================================

model Tag {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String   @db.ObjectId
  name           String
  color          String   @default("#6366f1")
  createdAt      DateTime @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignments  TagAssignment[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("tags")
}

model TagAssignment {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  tagId      String @db.ObjectId
  entityType String // "client", "lead", "project", "task", "expense", "document"
  entityId   String

  tag Tag @relation(fields: [tagId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Polymorphic relation – entityType + entityId reference the target entity
  // No explicit FK constraints since Prisma doesn't support multi-target FKs from one column

  @@unique([tagId, entityType, entityId])
  @@index([entityType, entityId])
  @@map("tag_assignments")
}

model CustomField {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String   @db.ObjectId
  entityType     String // "client", "lead", "project", "task"
  name           String
  fieldType      String // "text", "number", "date", "select", "multi_select", "boolean"
  options        Json? // for select/multi_select types
  isRequired     Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  values       CustomFieldValue[]

  @@unique([organizationId, entityType, name])
  @@index([organizationId])
  @@map("custom_fields")
}

model CustomFieldValue {
  id            String @id @default(auto()) @map("_id") @db.ObjectId
  customFieldId String @db.ObjectId
  entityId      String
  value         String

  customField CustomField @relation(fields: [customFieldId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([customFieldId, entityId])
  @@index([entityId])
  @@map("custom_field_values")
}

// ============================================================
// AI AGENT PLATFORM
// ============================================================

enum AgentRole {
  CEO
  CTO
  MARKETING
}

enum TaskOrigin {
  HUMAN
  AGENT
}

enum AgentRunStatus {
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum PublishChannel {
  INSTAGRAM
  LINKEDIN
  EMAIL
  WEBSITE
}

enum ContentType {
  IMAGE_POST
  TEXT_POST
  REEL
  BLOG_POST
  EMAIL
}

enum ContentStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELLED
}

enum SocialAccountStatus {
  CONNECTED
  EXPIRED
  REVOKED
  ERROR
  PAUSED
}

enum EmailDirection {
  INBOUND
  OUTBOUND
}

enum EmailStatus {
  RECEIVED
  TRIAGED
  DRAFTED
  QUEUED
  SENT
  FAILED
  CANCELLED
}

model BrandProfile {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  organizationId    String   @unique @db.ObjectId
  companyName       String
  tagline           String?
  description       String?
  mission           String?
  industry          String?
  targetAudience    String?
  toneOfVoice       String? // e.g. "professional but friendly, no jargon"
  contentGuidelines String? // do's and don'ts for generated content
  emailSignature    String?
  websiteUrl        String?
  instagramHandle   String?
  linkedinPage      String?
  brandColors       String[] @default([])
  logoUrl           String?
  assetUrls         String[] @default([])
  hashtagDefaults   String[] @default([])
  postingCadence    Json? // { instagram: "daily", linkedin: "weekdays", blog: "weekly" }
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("brand_profiles")
}

model SocialAccount {
  id             String              @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String              @db.ObjectId
  platform       PublishChannel
  accountName    String
  externalId     String? // IG user id / LinkedIn org URN / email address
  accessToken    String? // AES-256-GCM encrypted
  refreshToken   String? // AES-256-GCM encrypted
  tokenExpiresAt DateTime?
  scopes         String[]            @default([])
  status         SocialAccountStatus @default(CONNECTED)
  lastCheckedAt  DateTime?
  metadata       Json?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([organizationId, platform, accountName])
  @@index([organizationId])
  @@map("social_accounts")
}

model Agent {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String    @db.ObjectId
  role           AgentRole
  name           String
  title          String?
  systemPrompt   String
  // Set once a human edits the prompt, so platform prompt upgrades stop
  // overwriting their wording. Untouched prompts keep tracking the defaults in
  // role-prompts.ts -- otherwise agents created before a capability existed
  // would never be told how to use it.
  systemPromptCustomized Boolean @default(false)
  model          String    @default("gemini-flash-latest")
  tools          String[]  @default([])
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  runs         AgentRun[]
  contentItems ContentItem[]
  tasks        Task[]        @relation("AgentTasks")

  @@unique([organizationId, role])
  @@index([organizationId])
  @@map("agents")
}

model AgentRun {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String         @db.ObjectId
  agentId        String         @db.ObjectId
  trigger        String // "cron" | "task" | "email" | "manual"
  status         AgentRunStatus @default(RUNNING)
  input          String?
  output         String?
  error          String?
  steps          Int            @default(0)
  costTokens     Int            @default(0)
  startedAt      DateTime       @default(now())
  finishedAt     DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  agent        Agent         @relation(fields: [agentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  actions      AgentAction[]

  @@index([organizationId])
  @@index([agentId])
  @@map("agent_runs")
}

model AgentAction {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  runId     String   @db.ObjectId
  tool      String
  input     Json?
  output    Json?
  status    String   @default("ok") // "ok" | "error" | "blocked"
  error     String?
  createdAt DateTime @default(now())

  run AgentRun @relation(fields: [runId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([runId])
  @@map("agent_actions")
}

model ContentItem {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String         @db.ObjectId
  agentId        String?        @db.ObjectId
  channel        PublishChannel
  type           ContentType
  title          String?
  caption        String?
  body           String?
  imageUrl       String?
  imagePrompt    String?
  hashtags       String[]       @default([])

  // --- Research-first pipeline (research -> parse -> prompt -> media -> vision -> caption) ---
  // The parsed research brief the copy and media prompt were derived from.
  researchBrief  Json?
  // Source URLs returned by grounded search, so a claim can be traced back.
  sources        String[]       @default([])
  // Subset of `sources` whose full page text was actually fetched and read,
  // rather than only summarised by the search tool.
  readPages      String[]       @default([])
  // What the vision pass actually saw in the generated media. The caption is
  // written from this rather than from the image prompt, so it describes the
  // picture that exists instead of the one that was requested.
  mediaAnalysis  String?
  videoUrl       String?
  videoPrompt    String?
  // Per-stage outcome (ok / skipped / failed) so a degraded run is visible in
  // the UI instead of silently producing thinner content.
  pipeline       Json?

  status         ContentStatus  @default(DRAFT)
  scheduledFor   DateTime?
  publishedAt    DateTime?
  externalPostId String?
  error          String?
  attempts       Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  agent        Agent?       @relation(fields: [agentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organizationId])
  @@index([status])
  @@index([scheduledFor])
  @@map("content_items")
}

model EmailMessage {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String         @db.ObjectId
  direction      EmailDirection
  status         EmailStatus    @default(RECEIVED)
  fromAddress    String
  toAddress      String
  subject        String?
  bodyText       String?
  draftReply     String?
  threadKey      String?
  agentId        String?        @db.ObjectId
  holdUntil      DateTime? // hold-buffer: cancellable until this time
  sentAt         DateTime?
  error          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organizationId])
  @@index([status])
  @@index([threadKey])
  @@map("email_messages")
}

model AgentSettings {
  id                 String           @id @default(auto()) @map("_id") @db.ObjectId
  organizationId     String           @unique @db.ObjectId
  killSwitch         Boolean          @default(false) // halts ALL agent activity
  autonomyEnabled    Boolean          @default(true) // false = draft-only mode
  pausedChannels     PublishChannel[] @default([])
  maxPostsPerDay     Int              @default(3)
  maxAgentStepsPerRun Int             @default(8)
  maxTokensPerDay    Int              @default(500000)
  tokensUsedToday    Int              @default(0)
  tokensResetAt      DateTime?
  emailHoldMinutes   Int              @default(10)
  autoSendEmail      Boolean          @default(false) // emails default to approval
  emailAllowlist     String[]         @default([]) // empty = any recipient allowed
  dailyPlanHour      Int              @default(7) // org-local hour for CEO planning run
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("agent_settings")
}

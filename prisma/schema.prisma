model SubscriptionPlan {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  name          String       @unique
  description   String?
  price         Float
  currency      Currency     @default(USD)
  billingCycle  BillingCycle @default(MONTHLY)
  maxMembers    Int          @default(5)
  maxProjects   Int          @default(10)
  maxStorage    Int          @default(1024) // MB
  features      Json?
  isActive      Boolean      @default(true)
  stripePriceId String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id                   String             @id @default(auto()) @map("_id") @db.ObjectId
  organizationId       String             @unique @db.ObjectId
  planId               String             @db.ObjectId
  status               SubscriptionStatus @default(TRIALING)
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  trialEndsAt          DateTime?
  cancelledAt          DateTime?
  // Not @unique: same MongoDB non-sparse-unique-index issue as above --
  // Stripe isn't wired up yet (PRODUCTION_READINESS.md), so this is null for
  // every org's subscription; a second org's subscription would collide.
  stripeSubscriptionId String?
  stripeCustomerId     String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  plan         SubscriptionPlan @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

model Webhook {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  organizationId  String    @db.ObjectId
  url             String
  events          String[] // e.g., ["invoice.created", "payment.received"]
  secret          String
  isActive        Boolean   @default(true)
  lastTriggeredAt DateTime?
  failureCount    Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organizationId])
  @@map("webhooks")
}

model ApiKey {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String    @db.ObjectId
  name           String
  key            String    @unique
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("api_keys")
}


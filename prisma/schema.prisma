model Folder {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String   @db.ObjectId
  parentId       String?  @db.ObjectId
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parent       Folder?      @relation("SubFolders", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subFolders   Folder[]     @relation("SubFolders")
  documents    Document[]

  @@index([organizationId])
  @@index([parentId])
  @@map("folders")

# ============================================================
# Flow Backend – Environment Variables
# Copy this file to .env and fill in the values
# ============================================================

# ---- Application ----
NODE_ENV=development
PORT=3000
APP_NAME=Flow
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:4000

# ---- Database ----
DATABASE_URL=mongodb://127.0.0.1:27018/flow_db?replicaSet=rs0

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=flow_redis_secret

# ---- JWT ----
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# ---- OAuth: Google ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ---- OAuth: GitHub ----
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback

# ---- OAuth: Microsoft ----
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=http://localhost:3000/api/auth/microsoft/callback

# ---- Email (Resend / SMTP) ----
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=
MAIL_FROM=noreply@flow.dev

# ---- Stripe ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ---- Razorpay ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- PayPal ----
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ---- AWS S3 ----
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=flow-uploads

# ---- OpenAI ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4

# ---- Two-Factor Auth ----
TWO_FACTOR_APP_NAME=Flow

# ---- Rate Limiting ----
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ---- Cors ----
CORS_ORIGINS=http://localhost:4000,http://localhost:3000

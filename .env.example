# ============================================================
# Flow Backend – Environment Variables
# Copy this file to .env and fill in the values
# ============================================================

# ---- Application ----
NODE_ENV=development
PORT=3000
APP_NAME=Flow
APP_URL=http://localhost:3000
# Must match the port the Next.js frontend actually runs on (see
# frontend/package.json — `next dev -p 3001`). This said 4000 previously,
# which meant a fresh `cp .env.example .env` produced a CORS failure on the
# very first request the dashboard made.
FRONTEND_URL=http://localhost:3001

# ---- Database ----
DATABASE_URL=mongodb://127.0.0.1:27018/flow_db?replicaSet=rs0

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=flow_redis_secret

# ---- JWT ----
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# ---- OAuth: Google ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ---- OAuth: GitHub ----
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback

# ---- OAuth: Microsoft ----
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=http://localhost:3000/api/auth/microsoft/callback

# ---- Email (Resend / SMTP) ----
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=
MAIL_FROM=noreply@flow.dev

# ---- Stripe ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ---- Razorpay ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- PayPal ----
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ---- AWS S3 ----
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=flow-uploads

# ---- AI provider selection ----
# Which vendor backs research grounding, image, vision and video: openai | gemini.
# Capability availability is per-KEY, not just per-vendor: a free-tier Gemini key
# does text only and 429s on the other four. See docs/AGENT_PLATFORM_README.md.
AI_PROVIDER=openai

# ---- OpenAI ----
OPENAI_API_KEY=
# gpt-5-mini at low reasoning effort is ~3x faster than gpt-5 at default effort,
# and the pipeline makes 4-6 calls per post. Set effort to '' for non-reasoning
# models, which reject the parameter.
OPENAI_MODEL=gpt-5-mini
OPENAI_REASONING_EFFORT=low
OPENAI_IMAGE_MODEL=gpt-image-1-mini
OPENAI_VIDEO_MODEL=sora-2

# ---- Gemini (AI agents: text + image generation) ----
# NOTE: grounded search, image generation, vision analysis and video all require
# BILLING enabled on the key. A free-tier key returns 429 for those and the
# content pipeline falls back to text-only drafts.
GEMINI_API_KEY=
# Model used for research, parsing, prompt-building and captions.
# Free-tier daily caps vary sharply by model: `gemini-flash-latest` currently
# resolves to gemini-3.6-flash (20 requests/day). gemini-2.0-flash allows more.
TEXT_MODEL=gemini-2.0-flash

# ---- AI Agent Platform ----
# 32+ char secret used to encrypt social/email OAuth tokens at rest (AES-256-GCM)
AGENT_ENCRYPTION_KEY=
# gemini | openai | none
IMAGE_PROVIDER=gemini
# Gemini-native image output. The imagen-3.0-* / imagen-4.0-* models are retired
# for API keys created after their cutoff and return 404 NOT_FOUND.
IMAGE_MODEL=gemini-2.5-flash-image
VIDEO_MODEL=veo-3.1-fast-generate-preview
# Public base URL where generated images are reachable (Instagram must fetch them).
# Leave empty in dev to fall back to APP_URL.
PUBLIC_ASSETS_BASE_URL=
# Meta app (Instagram publishing)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URL=http://localhost:3000/api/channels/oauth/meta/callback
# LinkedIn app (company page publishing - requires Marketing Developer Platform)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URL=http://localhost:3000/api/channels/oauth/linkedin/callback

# ---- Two-Factor Auth ----
TWO_FACTOR_APP_NAME=Flow

# ---- Rate Limiting ----
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ---- Cors ----
# Comma-separated allow-list of browser origins. 3001 is the frontend; 3000 is
# the API itself (so the Swagger UI at /api/docs can call its own endpoints).
CORS_ORIGINS=http://localhost:3001,http://localhost:3000

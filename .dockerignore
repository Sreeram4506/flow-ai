# Keep the build context small and — more importantly — keep secrets and
# host-built artifacts out of the image.
node_modules
frontend/node_modules
dist
frontend/.next
coverage
*.tsbuildinfo

# Secrets: .env must never be baked into an image layer.
.env
.env.local
.env.*.local

.git
.github
.gitignore
.vscode
.idea

*.log
npm-debug.log*

# Docs / dev-only helpers
*.md
setup.sh
test-login.ps1
uploads
